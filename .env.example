# Copia este archivo como .env y llena tus valores. El .env NO se commitea.

# Serial del Unicorn Hybrid Black (etiqueta del casco o UnicornPy.GetAvailableDevices).
# Dejar vacio = modo simulador (MockUnicorn), no requiere hardware.
# Valor especial "LSL" = recibir el EEG por red desde otra maquina (ver tools/lsl_sender.py).
UNICORN_SERIAL=

# Ruta a la carpeta Lib del SDK UnicornPy (solo necesaria con hardware real), p. ej.:
# C:\Program Files\gtec\Unicorn Suite\Hybrid Black\Unicorn Python\Lib
UNICORN_SDK_PATH=
